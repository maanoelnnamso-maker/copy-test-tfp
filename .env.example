# Variable NAMES only. Values live in Railway and on the operator's machine, never in git.

# Which client this service is
CLIENT=
DATABASE_URL=

# EmailBison: one key per client workspace, named in clients/<client>/client.toml
EMAILBISON_API_KEY_CLIENT=

# Company and contact data providers
AIARK_API_KEY=
QUICKENRICH_API_KEY=
LEADOCEAN_API_KEY=
APOLLO_API_KEY=

# Email verification waterfall
MILLIONVERIFIER_API_KEY=
TRYKITT_API_KEY=
BOUNCEBAN_API_KEY=

# Language models and web reading
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
BUZZLEAD_API_KEY=
CONCENTRATE_AI_API_KEY=
JINA_API_KEY=
SERPER_API_KEY=

# Slack app for this client
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Switches
PIPELINE_ENABLED=true
TESTRUN_ENABLED=true            # the scale-up job (producer + consumer) runs inside the web service
NIGHTLY_ENABLED=true            # daily check: decide the copy test, run scale reviews, post status
SKIP_SENDER_ATTACH=true         # never attach sender accounts automatically
AUTO_START_CAMPAIGNS=false      # a person presses start

# Scale-up job
SCALE_TARGET_LEADS=
SCALE_BANK_CAP=900
SCALE_PRODUCER_THREADS=4        # contact-search chunks run side by side
SCALE_CHUNK=250                 # companies per chunk
SCALE_MAX_HOURS=20

# Fill campaigns (no copy written): "<campaign id>:<target>:company|materials", comma separated
MATERIALS_CAMPAIGNS=
HOLD_ANGLE_FILL=false           # true keeps the copy-test campaigns from taking bank contacts
